  "layout": {
    "type": "column",
    "padding": [
      0,
      24,
      8,
      24
    ],
    "children": [
      {
        "type": "row",
        "height": 48,
        "align": "center",
        "children": [
          {
            "type": "collapseButton"
          },
          {
            "type": "spacer",
            "weight": 1
          },
          {
            "type": "moreButton"
          }
        ]
      },
      {
        "type": "box",
        "weight": 1,
        "align": "center",
        "padding": [
          16,
          18
        ],
        "children": [
          {
            "type": "cover",
            "maxSize": 380,
            "shape": "rounded",
            "radius": 12
          }
        ]
      },
      {
        "type": "row",
        "align": "center",
        "children": [
          {
            "type": "songTitle",
            "weight": 1,
            "size": "large"
          },
          {
            "type": "likeButton"
          }
        ]
      },
      {
        "type": "artist",
        "size": "medium"
      },
      {
        "type": "miniLyric",
        "height": 48,
        "marquee": true,
        "onTap": "openLyrics"
      },
      {
        "type": "spacer",
        "height": 16
      },
      {
        "type": "row",
        "arrange": "spaceBetween",
        "align": "center",
        "padding": [
          0,
          8
        ],
        "children": [
          {
            "type": "actions",
            "width": 40,
            "buttons": [
              "sleepTimer"
            ]
          },
          {
            "type": "actions",
            "width": 40,
            "buttons": [
              "comments"
            ]
          },
          {
            "type": "actions",
            "width": 40,
            "buttons": [
              "share"
            ]
          }
        ]
      },
      {
        "type": "progress",
        "showTime": true
      },
      {
        "type": "row",
        "align": "center",
        "arrange": "spaceBetween",
        "children": [
          {
            "type": "controls",
            "width": 40,
            "buttons": [
              "playMode"
            ]
          },
          {
            "type": "controls",
            "width": 200,
            "buttons": [
              "previous",
              "playPause",
              "next"
            ],
            "size": "large"
          },
          {
            "type": "actions",
            "width": 40,
            "buttons": [
              "queue"
            ]
          }
        ]
      },
      {
        "type": "spacer",
        "height": 8
      }
    ]
  }
