{
  "frame": {
    "split": 0.45
  },
  "styles": {
    "accent": {
      "contentColor": "accent"
    },
    "muted": {
      "contentColor": "textSecondary"
    },
    "cover": {
      "shape": "rounded",
      "radius": 2,
      "elevation": 6,
      "animation": {
        "preset": "songChange",
        "effect": "zoom"
      },
      "onDoubleTap": "toggleLike"
    }
  },
  "layout": {
    "type": "column",
    "spacing": 12,
    "padding": [
      0,
      8
    ],
    "children": [
      {
        "type": "box",
        "weight": 1,
        "align": "center",
        "padding": 8,
        "children": [
          {
            "type": "cover",
            "class": "cover",
            "weight": 1
          }
        ]
      },
      {
        "type": "songInfo",
        "size": "small"
      },
      {
        "type": "progress",
        "showTime": false,
        "class": "accent"
      },
      {
        "type": "row",
        "align": "center",
        "spacing": 8,
        "children": [
          {
            "type": "time",
            "format": "position",
            "style": "caption",
            "class": "muted"
          },
          {
            "type": "miniLyric",
            "weight": 1,
            "class": "accent",
            "textAlign": "center",
            "marquee": true
          },
          {
            "type": "time",
            "format": "duration",
            "style": "caption",
            "class": "muted"
          }
        ]
      },
      {
        "type": "row",
        "arrange": "spaceEvenly",
        "align": "center",
        "children": [
          {
            "type": "controls",
            "buttons": [
              "previous"
            ],
            "variant": "plain",
            "size": "large"
          },
          {
            "type": "controls",
            "buttons": [
              "playPause"
            ],
            "variant": "plain",
            "size": "large"
          },
          {
            "type": "controls",
            "buttons": [
              "next"
            ],
            "variant": "plain",
            "size": "large"
          }
        ]
      },
      {
        "type": "row",
        "arrange": "spaceEvenly",
        "align": "center",
        "children": [
          {
            "type": "likeButton"
          },
          {
            "type": "controls",
            "buttons": [
              "playMode"
            ]
          },
          {
            "type": "actions",
            "buttons": [
              "comments"
            ]
          },
          {
            "type": "actions",
            "buttons": [
              "sleepTimer"
            ]
          },
          {
            "type": "actions",
            "buttons": [
              "queue"
            ]
          }
        ]
      }
    ]
  }
}
